{
  "name": "cloudops",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "pnpm db:generate",
    "predev": "pnpm db:generate",
    "prebuild": "pnpm db:generate",
    "build": "pnpm --recursive run build",
    "dev": "cross-env DID_YOU_KNOW=none pnpm --filter @cloudops/web --filter @cloudops/api --filter @cloudops/worker --parallel run dev",
    "dev:web": "cross-env DID_YOU_KNOW=none pnpm --filter @cloudops/web dev",
    "dev:api": "pnpm --filter @cloudops/api dev",
    "dev:worker": "pnpm --filter @cloudops/worker dev",
    "start": "pnpm --filter @cloudops/api start",
    "lint": "pnpm --recursive run lint",
    "test": "pnpm --recursive run test",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "seed:demo": "ts-node -T -O \"{\\\"module\\\":\\\"commonjs\\\",\\\"target\\\":\\\"es2021\\\",\\\"moduleResolution\\\":\\\"node\\\",\\\"esModuleInterop\\\":true}\" scripts/seed-demo.ts"
  },
  "devDependencies": {
    "@prisma/config": "^7.8.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1093.0",
    "@aws-sdk/client-ec2": "^3.1093.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1093.0",
    "@aws-sdk/client-sts": "^3.1091.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bullmq": "^5.8.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.0",
    "pg": "^8.22.0",
    "rxjs": "^7.8.1"
  }
}
