# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloudops?schema=public"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="admin"
JWT_EXPIRES_IN="1d"

# Server Configuration
PORT=3000

# App URL (used for password reset links)
APP_URL=http://localhost:8000

# SMTP Configuration (shared: notification emails + forgot password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@cloudops.dev
