datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED

  @@map("user_status")
}

enum CloudProvider {
  AWS
  GCP
  AZURE

  @@map("cloud_provider")
}

enum CloudAccountStatus {
  PENDING
  CONNECTED
  ERROR
  DISABLED

  @@map("cloud_account_status")
}

enum JobType {
  RESOURCE_SYNC
  METRIC_COLLECTION
  LOG_QUERY
  HEALTH_CHECK
  RULE_EVALUATION
  ALERT_NOTIFICATION

  @@map("job_type")
}

enum JobStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
  CANCELLED
  TIMED_OUT

  @@map("job_status")
}

enum ExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED

  @@map("execution_status")
}

enum AlertOperator {
  GT
  GTE
  LT
  LTE
  EQ
  NEQ

  @@map("alert_operator")
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL

  @@map("alert_severity")
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED

  @@map("alert_status")
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  MITIGATED
  RESOLVED
  CLOSED

  @@map("incident_status")
}

enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
  SEV4

  @@map("incident_severity")
}

enum NotificationChannel {
  EMAIL
  SLACK
  WEBHOOK

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED

  @@map("notification_status")
}

enum LogQueryStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("log_query_status")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.Text
  fullName     String     @map("full_name") @db.VarChar(150)
  role         UserRole
  status       UserStatus
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz

  sessions           Session[]
  auditLogs          AuditLog[]
  cloudAccounts      CloudAccount[]
  connectionChecks   CloudConnectionCheck[]
  jobs               Job[]
  alertRules         AlertRule[]
  acknowledgedAlerts Alert[]            @relation("AcknowledgedAlerts")
  resolvedAlerts     Alert[]            @relation("ResolvedAlerts")
  alertEvents        AlertEvent[]
  assignedIncidents  Incident[]         @relation("AssignedIncidents")
  createdIncidents   Incident[]         @relation("CreatedIncidents")
  linkedAlerts       IncidentAlert[]
  timelineEvents     IncidentTimeline[]
  evidence           IncidentEvidence[]

  @@index([status, role])
  @@map("users")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @map("token_hash") @db.Text
  tokenFamily String    @map("token_family") @db.Uuid
  userAgent   String?   @map("user_agent") @db.Text
  ipAddress   String?   @map("ip_address") @db.Inet
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model CloudAccount {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String             @db.VarChar(120)
  provider             CloudProvider
  providerAccountId    String             @map("provider_account_id") @db.VarChar(32)
  roleArn              String?            @map("role_arn") @db.Text
  externalIdCiphertext String?            @map("external_id_ciphertext") @db.Text
  status               CloudAccountStatus
  lastCheckedAt        DateTime?          @map("last_checked_at") @db.Timestamptz
  lastErrorCode        String?            @map("last_error_code") @db.VarChar(100)
  lastErrorMessage     String?            @map("last_error_message") @db.Text
  createdBy            String             @map("created_by") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?          @map("deleted_at") @db.Timestamptz

  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  regions          CloudAccountRegion[]
  connectionChecks CloudConnectionCheck[]
  resources        CloudResource[]
  jobs             Job[]
  logQueries       LogQuery[]
  alertRules       AlertRule[]

  @@unique([provider, providerAccountId])
  @@map("cloud_accounts")
}

model CloudAccountRegion {
  id             String    @id @default(uuid()) @db.Uuid
  cloudAccountId String    @map("cloud_account_id") @db.Uuid
  region         String    @db.VarChar(32)
  isEnabled      Boolean   @default(true) @map("is_enabled")
  lastSyncedAt   DateTime? @map("last_synced_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  cloudAccount CloudAccount @relation(fields: [cloudAccountId], references: [id], onDelete: Cascade)

  @@unique([cloudAccountId, region])
  @@map("cloud_account_regions")
}

model CloudConnectionCheck {
  id              String   @id @default(uuid()) @db.Uuid
  cloudAccountId  String   @map("cloud_account_id") @db.Uuid
  success         Boolean
  assumedRoleArn  String?  @map("assumed_role_arn") @db.Text
  callerAccountId String?  @map("caller_account_id") @db.VarChar(32)
  callerArn       String?  @map("caller_arn") @db.Text
  errorCode       String?  @map("error_code") @db.VarChar(100)
  errorMessage    String?  @map("error_message") @db.Text
  durationMs      Int?     @map("duration_ms")
  requestedBy     String?  @map("requested_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  cloudAccount CloudAccount @relation(fields: [cloudAccountId], references: [id], onDelete: Cascade)
  requester    User?        @relation(fields: [requestedBy], references: [id], onDelete: SetNull)

  @@index([cloudAccountId, createdAt(sort: Desc)])
  @@map("cloud_connection_checks")
}

model CloudResource {
  id                 String        @id @default(uuid()) @db.Uuid
  cloudAccountId     String        @map("cloud_account_id") @db.Uuid
  provider           CloudProvider
  region             String        @db.VarChar(32)
  resourceType       String        @map("resource_type") @db.VarChar(80)
  providerResourceId String        @map("provider_resource_id") @db.VarChar(255)
  name               String?       @db.VarChar(255)
  status             String?       @db.VarChar(80)
  tags               Json          @default("{}")
  metadata           Json          @default("{}")
  isActive           Boolean       @default(true) @map("is_active")
  firstDiscoveredAt  DateTime      @map("first_discovered_at") @db.Timestamptz
  lastSeenAt         DateTime      @map("last_seen_at") @db.Timestamptz
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  cloudAccount CloudAccount @relation(fields: [cloudAccountId], references: [id], onDelete: Cascade)

  jobs             Job[]
  metricPoints     MetricPoint[]
  metricAggregates MetricAggregate[]
  alertRules       AlertRule[]
  alerts           Alert[]
  incidents        Incident[]
  evidence         IncidentEvidence[]

  @@unique([provider, cloudAccountId, region, resourceType, providerResourceId])
  @@index([cloudAccountId, region, resourceType])
  @@index([resourceType, status, isActive])
  @@map("cloud_resources")
}

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  type           JobType
  status         JobStatus
  cloudAccountId String?   @map("cloud_account_id") @db.Uuid
  resourceId     String?   @map("resource_id") @db.Uuid
  requestedBy    String?   @map("requested_by") @db.Uuid
  payload        Json
  resultSummary  Json?     @map("result_summary")
  idempotencyKey String?   @unique @map("idempotency_key") @db.VarChar(255)
  priority       Int       @default(0) @db.SmallInt
  progress       Int       @default(0) @db.SmallInt
  attemptsMade   Int       @default(0) @db.SmallInt
  maxAttempts    Int       @default(3) @db.SmallInt
  queuedAt       DateTime? @map("queued_at") @db.Timestamptz
  startedAt      DateTime? @map("started_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  cloudAccount CloudAccount?  @relation(fields: [cloudAccountId], references: [id], onDelete: SetNull)
  resource     CloudResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  requester    User?          @relation(fields: [requestedBy], references: [id], onDelete: SetNull)

  executions JobExecution[]
  logQueries LogQuery[]

  @@map("jobs")
}

model JobExecution {
  id            String          @id @default(uuid()) @db.Uuid
  jobId         String          @map("job_id") @db.Uuid
  attemptNumber Int             @map("attempt_number") @db.SmallInt
  workerName    String?         @map("worker_name") @db.VarChar(120)
  status        ExecutionStatus
  startedAt     DateTime        @map("started_at") @db.Timestamptz
  finishedAt    DateTime?       @map("finished_at") @db.Timestamptz
  durationMs    BigInt?         @map("duration_ms")
  errorCode     String?         @map("error_code") @db.VarChar(100)
  errorType     String?         @map("error_type") @db.VarChar(100)
  errorMessage  String?         @map("error_message") @db.Text
  errorDetails  Json?           @map("error_details")
  output        Json?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  evidence IncidentEvidence[]

  @@unique([jobId, attemptNumber])
  @@map("job_executions")
}

model WorkerHeartbeat {
  workerId        String   @id @map("worker_id") @db.VarChar(120)
  queueName       String   @map("queue_name") @db.VarChar(120)
  hostname        String?  @db.VarChar(255)
  processId       Int?     @map("process_id")
  status          String   @db.VarChar(32)
  activeJobs      Int      @default(0) @map("active_jobs")
  lastHeartbeatAt DateTime @map("last_heartbeat_at") @db.Timestamptz
  startedAt       DateTime @map("started_at") @db.Timestamptz

  @@map("worker_heartbeats")
}

model MetricDefinition {
  id                   String        @id @default(uuid()) @db.Uuid
  provider             CloudProvider
  resourceType         String        @map("resource_type") @db.VarChar(80)
  namespace            String        @db.VarChar(120)
  metricName           String        @map("metric_name") @db.VarChar(120)
  defaultStatistic     String        @map("default_statistic") @db.VarChar(40)
  defaultPeriodSeconds Int           @map("default_period_seconds")
  unit                 String?       @db.VarChar(40)
  isEnabled            Boolean       @default(true) @map("is_enabled")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz

  metricPoints     MetricPoint[]
  metricAggregates MetricAggregate[]
  alertRules       AlertRule[]

  @@unique([provider, resourceType, namespace, metricName])
  @@map("metric_definitions")
}

model MetricPoint {
  id                 BigInt   @id @default(autoincrement())
  resourceId         String   @map("resource_id") @db.Uuid
  metricDefinitionId String   @map("metric_definition_id") @db.Uuid
  timestamp          DateTime @db.Timestamptz
  value              Float    @db.DoublePrecision
  unit               String?  @db.VarChar(40)
  dimensionsHash     String   @map("dimensions_hash") @db.VarChar(64)
  dimensions         Json     @default("{}")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  resource         CloudResource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  metricDefinition MetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Cascade)

  @@unique([resourceId, metricDefinitionId, timestamp, dimensionsHash])
  @@map("metric_points")
}

model MetricAggregate {
  id                 BigInt   @id @default(autoincrement())
  resourceId         String   @map("resource_id") @db.Uuid
  metricDefinitionId String   @map("metric_definition_id") @db.Uuid
  bucketStart        DateTime @map("bucket_start") @db.Timestamptz
  bucketSize         String   @map("bucket_size") @db.VarChar(20)
  minValue           Float?   @map("min_value") @db.DoublePrecision
  maxValue           Float?   @map("max_value") @db.DoublePrecision
  avgValue           Float?   @map("avg_value") @db.DoublePrecision
  sumValue           Float?   @map("sum_value") @db.DoublePrecision
  sampleCount        Int      @map("sample_count")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  resource         CloudResource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  metricDefinition MetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Cascade)

  @@unique([resourceId, metricDefinitionId, bucketStart, bucketSize])
  @@map("metric_aggregates")
}

model LogQuery {
  id              String         @id @default(uuid()) @db.Uuid
  jobId           String         @unique @map("job_id") @db.Uuid
  cloudAccountId  String         @map("cloud_account_id") @db.Uuid
  region          String         @db.VarChar(32)
  queryString     String         @map("query_string") @db.Text
  logGroups       Json           @map("log_groups")
  startTime       DateTime       @map("start_time") @db.Timestamptz
  endTime         DateTime       @map("end_time") @db.Timestamptz
  providerQueryId String?        @map("provider_query_id") @db.VarChar(255)
  status          LogQueryStatus
  resultCount     Int            @default(0) @map("result_count")
  scannedBytes    BigInt?        @map("scanned_bytes")
  expiresAt       DateTime?      @map("expires_at") @db.Timestamptz
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  completedAt     DateTime?      @map("completed_at") @db.Timestamptz

  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cloudAccount CloudAccount @relation(fields: [cloudAccountId], references: [id], onDelete: Cascade)

  results LogQueryResult[]

  @@map("log_queries")
}

model LogQueryResult {
  id               String   @id @default(uuid()) @db.Uuid
  logQueryId       String   @map("log_query_id") @db.Uuid
  sequenceNo       Int      @map("sequence_no")
  data             Json?
  objectStorageKey String?  @map("object_storage_key") @db.Text
  isMasked         Boolean  @default(true) @map("is_masked")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  logQuery LogQuery @relation(fields: [logQueryId], references: [id], onDelete: Cascade)

  evidence IncidentEvidence[]

  @@unique([logQueryId, sequenceNo])
  @@map("log_query_results")
}

model AlertRule {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String        @db.VarChar(160)
  cloudAccountId     String        @map("cloud_account_id") @db.Uuid
  resourceId         String?       @map("resource_id") @db.Uuid
  resourceType       String?       @map("resource_type") @db.VarChar(80)
  metricDefinitionId String?       @map("metric_definition_id") @db.Uuid
  operator           AlertOperator
  threshold          Float         @db.DoublePrecision
  durationSeconds    Int           @map("duration_seconds")
  severity           AlertSeverity
  cooldownSeconds    Int           @map("cooldown_seconds")
  recoveryThreshold  Float?        @map("recovery_threshold") @db.DoublePrecision
  isEnabled          Boolean       @default(true) @map("is_enabled")
  createdBy          String        @map("created_by") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz

  cloudAccount     CloudAccount      @relation(fields: [cloudAccountId], references: [id], onDelete: Cascade)
  resource         CloudResource?    @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  metricDefinition MetricDefinition? @relation(fields: [metricDefinitionId], references: [id], onDelete: SetNull)
  creator          User              @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  alerts Alert[]

  @@map("alert_rules")
}

model Alert {
  id               String        @id @default(uuid()) @db.Uuid
  alertRuleId      String        @map("alert_rule_id") @db.Uuid
  resourceId       String?       @map("resource_id") @db.Uuid
  status           AlertStatus
  severity         AlertSeverity
  fingerprint      String        @db.VarChar(128)
  title            String        @db.VarChar(255)
  message          String        @db.Text
  observedValue    Float?        @map("observed_value") @db.DoublePrecision
  thresholdValue   Float?        @map("threshold_value") @db.DoublePrecision
  firstTriggeredAt DateTime      @map("first_triggered_at") @db.Timestamptz
  lastTriggeredAt  DateTime      @map("last_triggered_at") @db.Timestamptz
  acknowledgedAt   DateTime?     @map("acknowledged_at") @db.Timestamptz
  acknowledgedBy   String?       @map("acknowledged_by") @db.Uuid
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz
  resolvedBy       String?       @map("resolved_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  alertRule    AlertRule      @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  resource     CloudResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  acknowledger User?          @relation("AcknowledgedAlerts", fields: [acknowledgedBy], references: [id], onDelete: SetNull)
  resolver     User?          @relation("ResolvedAlerts", fields: [resolvedBy], references: [id], onDelete: SetNull)

  events     AlertEvent[]
  incidents  IncidentAlert[]
  deliveries NotificationDelivery[]

  @@index([status, severity, lastTriggeredAt(sort: Desc)])
  @@index([resourceId, status])
  @@map("alerts")
}

model AlertEvent {
  id          String   @id @default(uuid()) @db.Uuid
  alertId     String   @map("alert_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(80)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  payload     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("alert_events")
}

model Incident {
  id                String           @id @default(uuid()) @db.Uuid
  incidentNumber    BigInt           @unique @default(autoincrement()) @map("incident_number")
  title             String           @db.VarChar(255)
  description       String?          @db.Text
  status            IncidentStatus
  severity          IncidentSeverity
  primaryResourceId String?          @map("primary_resource_id") @db.Uuid
  assigneeId        String?          @map("assignee_id") @db.Uuid
  createdBy         String           @map("created_by") @db.Uuid
  rootCause         String?          @map("root_cause") @db.Text
  resolutionNote    String?          @map("resolution_note") @db.Text
  openedAt          DateTime         @map("opened_at") @db.Timestamptz
  mitigatedAt       DateTime?        @map("mitigated_at") @db.Timestamptz
  resolvedAt        DateTime?        @map("resolved_at") @db.Timestamptz
  closedAt          DateTime?        @map("closed_at") @db.Timestamptz
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  primaryResource CloudResource? @relation(fields: [primaryResourceId], references: [id], onDelete: SetNull)
  assignee        User?          @relation("AssignedIncidents", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator         User           @relation("CreatedIncidents", fields: [createdBy], references: [id], onDelete: Restrict)

  alerts     IncidentAlert[]
  timeline   IncidentTimeline[]
  evidence   IncidentEvidence[]
  deliveries NotificationDelivery[]

  @@map("incidents")
}

model IncidentAlert {
  incidentId String   @map("incident_id") @db.Uuid
  alertId    String   @map("alert_id") @db.Uuid
  linkedBy   String   @map("linked_by") @db.Uuid
  linkedAt   DateTime @map("linked_at") @db.Timestamptz

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  alert    Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  linker   User     @relation(fields: [linkedBy], references: [id], onDelete: Restrict)

  @@id([incidentId, alertId])
  @@map("incident_alerts")
}

model IncidentTimeline {
  id          String   @id @default(uuid()) @db.Uuid
  incidentId  String   @map("incident_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(80)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  content     String?  @db.Text
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("incident_timeline")
}

model IncidentEvidence {
  id               String   @id @default(uuid()) @db.Uuid
  incidentId       String   @map("incident_id") @db.Uuid
  evidenceType     String   @map("evidence_type") @db.VarChar(60)
  jobExecutionId   String?  @map("job_execution_id") @db.Uuid
  logQueryResultId String?  @map("log_query_result_id") @db.Uuid
  resourceId       String?  @map("resource_id") @db.Uuid
  externalUrl      String?  @map("external_url") @db.Text
  snapshot         Json?
  addedBy          String   @map("added_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  incident       Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  jobExecution   JobExecution?   @relation(fields: [jobExecutionId], references: [id], onDelete: SetNull)
  logQueryResult LogQueryResult? @relation(fields: [logQueryResultId], references: [id], onDelete: SetNull)
  resource       CloudResource?  @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  adder          User            @relation(fields: [addedBy], references: [id], onDelete: Restrict)

  @@map("incident_evidence")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(120)
  targetType  String   @map("target_type") @db.VarChar(80)
  targetId    String?  @map("target_id") @db.VarChar(255)
  requestId   String?  @map("request_id") @db.Uuid
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent") @db.Text
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

model NotificationDelivery {
  id                String              @id @default(uuid()) @db.Uuid
  alertId           String?             @map("alert_id") @db.Uuid
  incidentId        String?             @map("incident_id") @db.Uuid
  channel           NotificationChannel
  destination       String              @db.Text
  templateCode      String              @map("template_code") @db.VarChar(120)
  status            NotificationStatus
  deduplicationKey  String              @unique @map("deduplication_key") @db.VarChar(255)
  attemptCount      Int                 @default(0) @map("attempt_count") @db.SmallInt
  providerMessageId String?             @map("provider_message_id") @db.VarChar(255)
  lastError         String?             @map("last_error") @db.Text
  scheduledAt       DateTime?           @map("scheduled_at") @db.Timestamptz
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  alert    Alert?    @relation(fields: [alertId], references: [id], onDelete: SetNull)
  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@map("notification_deliveries")
}
